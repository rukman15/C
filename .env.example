# Sama dengan aplikasi lama (../.env.example): database Supabase yang sama.
DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://...:5432/postgres"

# HARUS sama dengan BBPKA_SESSION_SECRET aplikasi lama supaya cookie sesi berlaku di keduanya.
# Wajib diisi di luar `npm run dev`. Generate: openssl rand -hex 32
BBPKA_SESSION_SECRET=
