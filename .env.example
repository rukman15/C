# Sama dengan aplikasi lama (proyek Vercel "bangkom"): database Supabase yang sama.
# Supabase -> Connect -> ORM -> Prisma. Di Vercel pakai yang port 6543 (pgbouncer).
DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://...:5432/postgres"

# HARUS sama dengan BBPKA_SESSION_SECRET aplikasi lama. Wajib di luar `npm run dev`. Generate: openssl rand -hex 32
BBPKA_SESSION_SECRET=

# Penyimpanan berkas (bucket privat "dokumen-peserta"). RAHASIA: hanya di .env / Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive balai (opsional, sama dengan aplikasi lama; lihat docs/fitur/CATATAN-PENYIMPANAN-GDRIVE.md di repo lama).
# GDRIVE_FOLDER_ID=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# GDRIVE_SERVICE_ACCOUNT_JSON=
